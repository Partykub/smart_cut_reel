{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://smart-cut-reel/contracts/job_manifest.schema.json",
    "title": "Smart Cut Reel Job Manifest",
    "description": "Job manifest for Smart Cut Reel pipeline presets: smooth vertical reframe (16:9→9:16), optional dead-air cutting, optional audio enhancement + ASR + filler cuts. Each preset uses one canonical pipeline_id.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "job_id",
        "created_at",
        "created_by",
        "input",
        "target_output",
        "pipeline"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "enum": [
                "1.0.0",
                "2.0.0",
                "3.0.0"
            ]
        },
        "job_id": {
            "type": "string",
            "pattern": "^job_[A-Za-z0-9_-]+$"
        },
        "created_at": {
            "type": "string",
            "format": "date-time"
        },
        "created_by": {
            "type": "string",
            "enum": [
                "orchestrator",
                "debug_frontend",
                "integration_test"
            ]
        },
        "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source_video"
            ],
            "properties": {
                "source_video": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "object_key",
                        "original_filename",
                        "uploaded_at"
                    ],
                    "properties": {
                        "object_key": {
                            "type": "string",
                            "pattern": "^jobs/[^/]+/input/source\\.mp4$"
                        },
                        "original_filename": {
                            "type": "string",
                            "minLength": 1
                        },
                        "uploaded_at": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "content_type": {
                            "type": "string",
                            "minLength": 1
                        },
                        "checksum_sha256": {
                            "type": "string",
                            "pattern": "^[A-Fa-f0-9]{64}$"
                        }
                    }
                }
            }
        },
        "target_output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "aspect_ratio",
                "resolution",
                "format",
                "object_key"
            ],
            "properties": {
                "aspect_ratio": {
                    "type": "string",
                    "const": "9:16"
                },
                "resolution": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "width",
                        "height"
                    ],
                    "properties": {
                        "width": {
                            "type": "integer",
                            "minimum": 2,
                            "multipleOf": 2
                        },
                        "height": {
                            "type": "integer",
                            "minimum": 2,
                            "multipleOf": 2
                        }
                    }
                },
                "format": {
                    "type": "string",
                    "const": "mp4"
                },
                "object_key": {
                    "type": "string",
                    "pattern": "^jobs/[^/]+/outputs/final_9x16\\.mp4$"
                }
            }
        },
        "pipeline": {
            "oneOf": [
                {
                    "$ref": "#/$defs/pipelinePresetReframeOnly"
                },
                {
                    "$ref": "#/$defs/pipelinePresetSmoothAudio"
                },
                {
                    "$ref": "#/$defs/pipelinePresetDeadAir"
                },
                {
                    "$ref": "#/$defs/pipelinePresetDeadAirEnhanced"
                },
                {
                    "$ref": "#/$defs/pipelinePresetAudioQuality"
                }
            ]
        },
        "enabled_features": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "remove_dead_air": {
                    "type": "boolean"
                },
                "enhance_audio": {
                    "type": "boolean"
                },
                "remove_filler_words": {
                    "type": "boolean"
                }
            }
        },
        "audio_profile": {
            "type": "string",
            "enum": [
                "original",
                "podcast",
                "social",
                "broadcast"
            ],
            "description": "Optional preset selected at job creation; merged into service_config.audio_enhancement."
        },
        "service_config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "proxy_frame_sampling": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "proxy_height"
                    ],
                    "properties": {
                        "sample_fps": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "sample_every_n_source_frames": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "proxy_height": {
                            "type": "integer",
                            "minimum": 2,
                            "multipleOf": 2
                        }
                    }
                },
                "body_detection": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "face_detector_backend": {
                            "type": "string",
                            "enum": [
                                "retinaface",
                                "face_recognition"
                            ]
                        },
                        "subject_selection_strategy": {
                            "type": "string",
                            "enum": [
                                "largest_box",
                                "nearest_previous_crop_center",
                                "highest_confidence"
                            ]
                        },
                        "min_confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "model_path": {
                            "type": "string",
                            "minLength": 1
                        },
                        "device_preference": {
                            "type": "string",
                            "enum": [
                                "gpu_first",
                                "cpu"
                            ]
                        },
                        "image_size": {
                            "type": "integer",
                            "minimum": 32
                        },
                        "person_class_id": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "face_min_confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "face_recognition_model": {
                            "type": "string",
                            "enum": [
                                "hog",
                                "cnn"
                            ]
                        }
                    }
                },
                "track_interpolation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "max_gap_fill_seconds",
                        "max_center_jump_per_second",
                        "missing_strategy"
                    ],
                    "properties": {
                        "max_gap_fill_seconds": {
                            "type": "number",
                            "minimum": 0
                        },
                        "max_center_jump_per_second": {
                            "type": "number",
                            "minimum": 0
                        },
                        "missing_strategy": {
                            "type": "string",
                            "enum": [
                                "hold_then_center",
                                "hold_last",
                                "center_crop"
                            ]
                        }
                    }
                },
                "reframe_planning": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "framing_mode": {
                            "type": "string",
                            "enum": [
                                "center_subject",
                                "rule_of_thirds",
                                "stable_speaker"
                            ]
                        },
                        "clamp_to_source": {
                            "type": "boolean"
                        },
                        "face_hint_strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "face_hint_max_ratio": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "face_hint_dead_zone_px": {
                            "type": "number",
                            "minimum": 0
                        },
                        "lookahead_switch_confirmation_frames": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "face_hint_smoothing_strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "stable_zone_trigger_ratio": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "stable_zone_release_ratio": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "stable_zone_offset_ratio": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "stable_hold_seconds": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                "easing_smoothing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "smoothing_method",
                        "smoothing_strength",
                        "max_velocity_px_per_second",
                        "max_acceleration_px_per_second2",
                        "easing",
                        "dead_zone_px"
                    ],
                    "properties": {
                        "smoothing_method": {
                            "type": "string",
                            "enum": [
                                "moving_average",
                                "exponential",
                                "kalman"
                            ]
                        },
                        "smoothing_strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "max_velocity_px_per_second": {
                            "type": "number",
                            "minimum": 0
                        },
                        "max_acceleration_px_per_second2": {
                            "type": "number",
                            "minimum": 0
                        },
                        "easing": {
                            "type": "string",
                            "enum": [
                                "linear",
                                "easeOutCubic",
                                "easeInOutCubic",
                                "easeInOutSine"
                            ]
                        },
                        "dead_zone_px": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                "render_plan_compiler": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "crop_representation": {
                            "type": "string",
                            "enum": [
                                "keyframe_list",
                                "per_frame_list",
                                "ffmpeg_expression_file"
                            ]
                        },
                        "audio_policy": {
                            "type": "string",
                            "enum": [
                                "copy_if_possible_else_aac",
                                "aac_transcode"
                            ]
                        },
                        "compiler_render_mode": {
                            "type": "string",
                            "enum": [
                                "smooth_crop",
                                "smooth_crop_with_cuts",
                                "full_frame_with_cuts"
                            ]
                        },
                        "output_audio_source": {
                            "type": "string",
                            "enum": [
                                "source_video",
                                "enhanced_wav"
                            ],
                            "description": "Where final mux audio is sliced from: embedded source track or enhanced_audio.wav (requires audio_enhancement step)."
                        }
                    }
                },
                "ffmpeg_renderer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "video_codec": {
                            "type": "string",
                            "enum": [
                                "libx264"
                            ]
                        },
                        "audio_codec": {
                            "type": "string",
                            "enum": [
                                "aac"
                            ]
                        }
                    }
                },
                "audio_extraction": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "sample_rate": {
                            "type": "integer",
                            "enum": [
                                8000,
                                16000,
                                22050,
                                44100,
                                48000
                            ]
                        },
                        "channels": {
                            "type": "integer",
                            "enum": [
                                1,
                                2
                            ]
                        }
                    }
                },
                "voice_activity_detection": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "model": {
                            "type": "string",
                            "enum": [
                                "silero_v4",
                                "silero_v5"
                            ]
                        },
                        "audio_source": {
                            "type": "string",
                            "enum": [
                                "extracted_audio",
                                "enhanced_audio",
                                "enhanced_audio_or_extracted"
                            ]
                        },
                        "speech_threshold": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "min_speech_duration_seconds": {
                            "type": "number",
                            "minimum": 0
                        },
                        "min_silence_duration_seconds": {
                            "type": "number",
                            "minimum": 0
                        },
                        "speech_pad_seconds": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                "audio_enhancement": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "denoise_model": {
                            "type": "string",
                            "enum": [
                                "off",
                                "std",
                                "leaky"
                            ]
                        },
                        "target_lufs": {
                            "type": "number"
                        },
                        "true_peak_db": {
                            "type": "number"
                        },
                        "loudness_range": {
                            "type": "number",
                            "minimum": 0
                        },
                        "highpass_frequency_hz": {
                            "type": "number",
                            "minimum": 0
                        },
                        "loudness_normalization_enabled": {
                            "type": "boolean",
                            "description": "When false, skip loudnorm; combined with denoise off and highpass 0, the step copies extracted_audio to enhanced_audio unchanged."
                        }
                    }
                },
                "transcription": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "model": {
                            "type": "string",
                            "enum": [
                                "tiny",
                                "tiny.en",
                                "base",
                                "base.en",
                                "small",
                                "small.en",
                                "medium",
                                "medium.en"
                            ]
                        },
                        "language": {
                            "type": "string"
                        },
                        "compute_type": {
                            "type": "string",
                            "enum": [
                                "int8",
                                "int8_float16",
                                "float16",
                                "float32"
                            ]
                        },
                        "filler_words_th": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "filler_words_en": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "filler_min_silence_around_seconds": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                "dead_air_cut_planning": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "silence_threshold_seconds": {
                            "type": "number",
                            "minimum": 0
                        },
                        "keep_padding_before": {
                            "type": "number",
                            "minimum": 0
                        },
                        "keep_padding_after": {
                            "type": "number",
                            "minimum": 0
                        },
                        "min_keep_segment_seconds": {
                            "type": "number",
                            "minimum": 0
                        },
                        "filler_padding_before": {
                            "type": "number",
                            "minimum": 0
                        },
                        "filler_padding_after": {
                            "type": "number",
                            "minimum": 0
                        },
                        "merge_adjacent_cuts_within_seconds": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "pipelinePresetReframeOnly": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pipeline_id",
                "steps"
            ],
            "properties": {
                "pipeline_id": {
                    "type": "string",
                    "enum": [
                        "reframe_16x9_to_9x16"
                    ]
                },
                "steps": {
                    "type": "array",
                    "const": [
                        "validation",
                        "media_metadata",
                        "proxy_frame_sampling",
                        "body_detection",
                        "track_interpolation",
                        "reframe_planning",
                        "easing_smoothing",
                        "render_plan_compiler",
                        "ffmpeg_renderer"
                    ]
                }
            }
        },
        "pipelinePresetSmoothAudio": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pipeline_id",
                "steps"
            ],
            "properties": {
                "pipeline_id": {
                    "type": "string",
                    "enum": [
                        "reframe_16x9_to_9x16_smooth_audio"
                    ]
                },
                "steps": {
                    "type": "array",
                    "const": [
                        "validation",
                        "media_metadata",
                        "audio_extraction",
                        "audio_enhancement",
                        "proxy_frame_sampling",
                        "body_detection",
                        "track_interpolation",
                        "reframe_planning",
                        "easing_smoothing",
                        "render_plan_compiler",
                        "ffmpeg_renderer"
                    ]
                }
            }
        },
        "pipelinePresetDeadAir": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pipeline_id",
                "steps"
            ],
            "properties": {
                "pipeline_id": {
                    "type": "string",
                    "enum": [
                        "reframe_16x9_to_9x16_dead_air"
                    ]
                },
                "steps": {
                    "type": "array",
                    "const": [
                        "validation",
                        "media_metadata",
                        "audio_extraction",
                        "voice_activity_detection",
                        "dead_air_cut_planning",
                        "proxy_frame_sampling",
                        "body_detection",
                        "track_interpolation",
                        "reframe_planning",
                        "easing_smoothing",
                        "render_plan_compiler",
                        "ffmpeg_renderer"
                    ]
                }
            }
        },
        "pipelinePresetDeadAirEnhanced": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pipeline_id",
                "steps"
            ],
            "properties": {
                "pipeline_id": {
                    "type": "string",
                    "enum": [
                        "reframe_16x9_to_9x16_dead_air_enhanced"
                    ]
                },
                "steps": {
                    "type": "array",
                    "const": [
                        "validation",
                        "media_metadata",
                        "audio_extraction",
                        "audio_enhancement",
                        "voice_activity_detection",
                        "dead_air_cut_planning",
                        "proxy_frame_sampling",
                        "body_detection",
                        "track_interpolation",
                        "reframe_planning",
                        "easing_smoothing",
                        "render_plan_compiler",
                        "ffmpeg_renderer"
                    ]
                }
            }
        },
        "pipelinePresetAudioQuality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pipeline_id",
                "steps"
            ],
            "properties": {
                "pipeline_id": {
                    "type": "string",
                    "enum": [
                        "reframe_16x9_to_9x16_audio_quality"
                    ]
                },
                "steps": {
                    "type": "array",
                    "const": [
                        "validation",
                        "media_metadata",
                        "audio_extraction",
                        "audio_enhancement",
                        "voice_activity_detection",
                        "transcription",
                        "dead_air_cut_planning",
                        "proxy_frame_sampling",
                        "body_detection",
                        "track_interpolation",
                        "reframe_planning",
                        "easing_smoothing",
                        "render_plan_compiler",
                        "ffmpeg_renderer"
                    ]
                }
            }
        }
    }
}