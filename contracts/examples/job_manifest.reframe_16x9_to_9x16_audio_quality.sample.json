    "enabled_features": {
        "remove_dead_air": true,
        "enhance_audio": true,
        "remove_filler_words": true
    },
    "service_config": {
        "audio_extraction": {
            "sample_rate": 48000,
            "channels": 1
        },
        "audio_enhancement": {
            "denoise_model": "off",
            "target_lufs": -16.0,
            "true_peak_db": -1.5,
            "loudness_range": 11.0,
            "highpass_frequency_hz": 0,
            "loudness_normalization_enabled": true
        },
        "voice_activity_detection": {
            "model": "silero_v5",
