                "uh",
                "uhh",
                "uhm",
                "ah",
                "er",
                "erm"
            ],
            "filler_min_silence_around_seconds": 0.05
        },
        "dead_air_cut_planning": {
            "silence_threshold_seconds": 0.8,
            "keep_padding_before": 0.15,
            "keep_padding_after": 0.2,
            "min_keep_segment_seconds": 0.5,
            "filler_padding_before": 0.05,
            "filler_padding_after": 0.05,
            "merge_adjacent_cuts_within_seconds": 0.1
        },
        "proxy_frame_sampling": {
            "proxy_height": 540,
            "sample_every_n_source_frames": 1
        },
        "body_detection": {
            "face_detector_backend": "retinaface",
            "subject_selection_strategy": "nearest_previous_crop_center",
            "min_confidence": 0.9,
            "model_path": "yolov8m.pt",
            "device_preference": "gpu_first",
            "image_size": 640,
            "person_class_id": 0,
            "face_min_confidence": 0.6,
            "face_recognition_model": "hog"
        },
        "track_interpolation": {
            "max_gap_fill_seconds": 1.0,
            "max_center_jump_per_second": 600,
            "missing_strategy": "hold_then_center"
        },
        "reframe_planning": {
            "framing_mode": "center_subject",
            "clamp_to_source": true,
            "face_hint_dead_zone_px": 48
        },
        "easing_smoothing": {
            "smoothing_method": "exponential",
            "smoothing_strength": 0.82,
            "max_velocity_px_per_second": 700,
            "max_acceleration_px_per_second2": 1600,
            "easing": "easeInOutCubic",
            "dead_zone_px": 80
